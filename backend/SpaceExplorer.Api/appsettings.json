{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Spaces": [
    {
      "Key": "A",
      "DisplayName": "Espace A",
      "CsvPath": "\\\\server\\share\\spaceA.csv",
      "BasePath": "D:\\Data\\SpaceA",
      "Encoding": "utf-8"
    },
    {
      "Key": "B",
      "DisplayName": "Espace B",
      "CsvPath": "\\\\server\\share\\spaceB.csv",
      "BasePath": "E:\\Data\\SpaceB",
      "Encoding": "utf-8"
    }
  ],
  "DataRefresh": {
    "CheckIntervalMinutes": 10
  },
  "Authentication": {
    "Mode": "Oidc",
    "Oidc": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "NameClaim": "preferred_username",
      "GroupClaim": "group",
      "Scopes": [ "openid", "profile" ]
    }
  },
  "Authorization": {
    "AdminGroup": "Admin"
  }
}
